# ─── Database (any Postgres: local docker, Neon, Supabase) ───────────────────
DATABASE_URL="postgresql://frostflow:frostflow_dev_pass@localhost:5432/frostflow"

# ─── Redis (BullMQ queue). Local: redis://127.0.0.1:6379 — Upstash: rediss://... (TCP URL, not REST)
REDIS_URL="redis://127.0.0.1:6379"

# ─── Worker API (apps/worker) ────────────────────────────────────────────────
API_PORT="4000"
WORKER_CONCURRENCY="2"
# Free scans are completely unlimited
FREE_TIER_DAILY_LIMIT="999999"
MAX_PAGES_HARD_CAP="25"
# URL of the worker as seen from the web app
WORKER_API_URL="http://localhost:4000"
# Shared secret between web and worker (generate: openssl rand -hex 32). REQUIRED.
INTERNAL_API_KEY=""
# Comma-separated list of allowed CORS origins for the worker (optional; API is server-to-server)
CORS_ORIGINS=""

# ─── AI report (Studio/Agency) ───────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# ─── PDF + screenshot storage (Uploadthing). Optional: skipped when empty ────
UPLOADTHING_SECRET=""

# ─── Email alerts for monitors (Resend). Optional ────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="FrostFlow <alerts@yourdomain.com>"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
